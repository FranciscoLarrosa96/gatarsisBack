{
  "name": "gatarsis-commerce-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Gatarsis Commerce API - catalog, inventory reservations and orders",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "db:migration:generate": "typeorm-ts-node-commonjs migration:generate src/database/migrations/AutoMigration -d src/database/data-source.ts",
    "db:migration:run": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "db:migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
    "db:seed": "ts-node -r tsconfig-paths/register src/database/seeds/dev.seed.ts",
    "admin:bootstrap": "ts-node -r tsconfig-paths/register src/admin/bootstrap-admin.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.1",
    "@nestjs/core": "11.2.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "11.2.1",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "11.0.3",
    "bcryptjs": "^3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "^17.3.1",
    "helmet": "^8.3.0",
    "mercadopago": "^3.4.0",
    "nodemailer": "^10.0.9",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.28"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.14",
    "@nestjs/schematics": "11.0.7",
    "@nestjs/testing": "11.2.1",
    "@types/express": "5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "24.10.1",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "6.0.3",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.4",
    "jest": "30.4.2",
    "prettier": "3.8.2",
    "source-map-support": "0.5.21",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.0"
  }
}
